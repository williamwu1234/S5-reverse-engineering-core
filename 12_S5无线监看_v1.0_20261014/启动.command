#!/bin/bash
# 双击本文件即可启动（macOS）
cd "$(dirname "$0")"
clear
echo "=============================================="
echo "  DC-S5 无线监看"
echo "=============================================="
echo
printf " 请输入相机 IP（直接回车用 192.168.1.131）: "
read -r IP
IP="${IP:-192.168.1.131}"   # ← 默认相机地址，可传入你自己的 IP
echo
exec ./run.sh "$IP"
